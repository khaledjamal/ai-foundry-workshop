{
  "version": "2.0",
  "extensions": {
    "mcp": {
      "serverName": "workout-tools",
      "serverVersion": "1.0.0",
      "instructions": "Workout tools: call list_workout_goals to see the goals, then suggest_workout with a goal and minutes."
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  }
}
